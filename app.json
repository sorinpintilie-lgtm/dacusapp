{
  "expo": {
    "name": "Dacus.ro",
    "slug": "dacusapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./apps/mobile/assets/icon.png",
    "plugins": [
      "expo-font",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-background-fetch"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./apps/mobile/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "092f9915-4e7c-482c-b05d-d29eb0961a69"
      },
      "apiBaseUrl": "${EXPO_PUBLIC_API_BASE_URL}"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./apps/mobile/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ro.dacus.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ro.dacus.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "Dacus.ro",
        "CFBundleName": "Dacus.ro",
        "NSCameraUsageDescription": "Dacus folosește camera pentru a scana coduri QR și a verifica produsele.",
        "NSPhotoLibraryUsageDescription": "Dacus folosește biblioteca foto pentru a salva imaginile produselor.",
        "NSPhotoLibraryAddUsageDescription": "Dacus folosește biblioteca foto pentru a salva imaginile produselor.",
        "NSLocationWhenInUseUsageDescription": "Dacus folosește locația pentru a găsi magazinele apropiate.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Dacus folosește locația pentru a trimite notificări despre oferte apropiate.",
        "NSFaceIDUsageDescription": "Dacus folosește Face ID pentru autentificare rapidă și sigură.",
        "UIBackgroundModes": ["remote-notification", "processing"],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Editor",
            "CFBundleURLSchemes": ["ro.dacus.mobile", "dacus"]
          }
        ]
      }
    }
  }
}
