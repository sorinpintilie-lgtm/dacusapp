{
  "expo": {
    "name": "Dacus.ro",
    "slug": "dacusapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./apps/mobile/assets/icon.png",
    "plugins": [
      "expo-font",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./apps/mobile/assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "092f9915-4e7c-482c-b05d-d29eb0961a69"
      },
      "apiBaseUrl": "${EXPO_PUBLIC_API_BASE_URL}"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./apps/mobile/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ro.dacus.mobile",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ro.dacus.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "Dacus.ro",
        "CFBundleName": "Dacus.ro",
        "NSFaceIDUsageDescription": "Dacus folosește Face ID pentru autentificare rapidă și sigură.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Editor",
            "CFBundleURLSchemes": [
              "ro.dacus.mobile",
              "dacus"
            ]
          }
        ]
      }
    }
  }
}
