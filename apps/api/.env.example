NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=*
CATALOG_CACHE_TTL_MS=60000
SEARCH_MAX_PER_PAGE=60

# Shopify configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=replace-with-storefront-token
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-admin-token
SHOPIFY_WEBHOOK_SECRET=replace-with-webhook-secret

# Typesense search index (recommended for large catalogs)
TYPESENSE_ENABLED=false
TYPESENSE_HOST=xxxxx.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_ADMIN_KEY=replace-with-typesense-admin-key
TYPESENSE_COLLECTION=products
TYPESENSE_TIMEOUT_SECONDS=5

# Secure sync trigger + webhook registration
SYNC_SECRET=replace-with-random-sync-secret
APP_URL=https://your-app.com

# Loyalty security
LOYALTY_QR_SIGNING_KEY=replace-with-min-32-char-random-secret
POS_SCAN_API_KEYS=pos-key-1,pos-key-2

# Firebase (optional, recommended for production persistence)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Optional: use local service-account file path instead of inline FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY
# FIREBASE_SERVICE_ACCOUNT_PATH=./dacus-b40f9-firebase-adminsdk-fbsvc-676c0372c0.json

