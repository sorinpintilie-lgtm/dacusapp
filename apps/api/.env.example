NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=*
CATALOG_CACHE_TTL_MS=60000

# Shopify configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=replace-with-storefront-token
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-admin-token

# Loyalty security
LOYALTY_QR_SIGNING_KEY=replace-with-min-32-char-random-secret

