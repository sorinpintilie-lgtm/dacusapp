{
  "name": "@dacus/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "npm exec eslint -- App.tsx src",
    "typecheck": "tsc --noEmit",
    "test": "npm exec vitest -- run",
    "doctor": "cd ../.. && (npx expo-doctor || npx expo-doctor)",
    "export:ios": "npx expo export -p ios --output-dir out-ios",
    "export:android": "npx expo export -p android --output-dir out-android",
    "verify:release": "npm run typecheck && npm run test && npm run export:ios && npm run export:android && (npm run doctor || echo expo-doctor network timeout - review manually)"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo/vector-icons": "15.1.1",
    "@react-navigation/bottom-tabs": "~7.4.8",
    "@react-navigation/elements": "~2.6.5",
    "@react-navigation/native": "~7.1.18",
    "@react-navigation/native-stack": "~7.3.27",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.28",
    "expo-background-fetch": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-task-manager": "~57.0.21",
    "firebase": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
