{
  "name": "@dacus/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "npm exec eslint -- App.tsx src",
    "typecheck": "tsc --noEmit",
    "test": "npm exec vitest -- run",
    "doctor": "cd ../.. && (npx expo-doctor || npx expo-doctor)",
    "export:ios": "npx expo export -p ios --output-dir out-ios",
    "export:android": "npx expo export -p android --output-dir out-android",
    "verify:release": "npm run typecheck && npm run test && npm run export:ios && npm run export:android && (npm run doctor || echo expo-doctor network timeout - review manually)"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.3",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-local-authentication": "~14.0.1",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.29.14",
    "expo-background-fetch": "~14.0.9",
    "expo-splash-screen": "~31.0.13",
    "expo-task-manager": "~14.0.9",
    "firebase": "^11.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "typescript": "^5.9.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
