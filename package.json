{
  "name": "dacusapp",
  "version": "0.1.0",
  "private": true,
  "description": "Dacus.ro mobile app monorepo (React Native + loyalty backend)",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @dacus/api",
    "dev:mobile": "npm run start -w @dacus/mobile",
    "build:api": "npm run build -w @dacus/api",
    "firebase:serve": "firebase emulators:start --only functions",
    "firebase:deploy": "firebase deploy --only functions:api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:mobile:release": "npm run verify:release -w @dacus/mobile",
    "sync:catalog:firestore": "node scripts/sync-shopify-catalog-to-firestore.mjs",
    "export:catalog:snapshot": "node scripts/export-firestore-catalog-snapshot.mjs",
    "build:catalog:mobile": "node scripts/build-mobile-catalog.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "refresh:catalog:mobile": "node scripts/refresh-mobile-catalog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.26.1"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "expo": "~57.0.28",
    "expo-background-fetch": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^3.24.2"
  }
}
